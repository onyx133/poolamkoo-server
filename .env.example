# Copy to .env for local development. Never commit the real .env.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgresql://poolamkoo_app:change-me@localhost:5432/poolamkoo

# >= 32 bytes, base64 or hex. Generate: openssl rand -base64 48
SERVER_PEPPER=
# >= 32 bytes. Generate: openssl rand -base64 48
JWT_SECRET=
JWT_TTL_DAYS=30

# false | true | hop count (e.g. 1) | comma-separated CIDR list
TRUST_PROXY=false

# base64 raw 32-byte Ed25519 public key (verification only; the private key never reaches the server)
RULEPACK_PUBLIC_KEY=

# requests per IP per minute
RATE_LIMIT_MAX=120
DOCS_ENABLED=true
# defaults to the version in package.json
APP_VERSION=
