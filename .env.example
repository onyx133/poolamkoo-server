# Copy to .env for local development. Never commit the real .env.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgresql://poolamkoo_app:change-me@localhost:5432/poolamkoo
# maximum pooled database connections
DB_POOL_MAX=10

# >= 32 bytes, canonical base64 (with padding) or hex. Generate: openssl rand -base64 48
SERVER_PEPPER=
# >= 32 bytes, same format. Generate: openssl rand -base64 48
JWT_SECRET=
JWT_TTL_DAYS=30

# false | true | hop count (e.g. 1) | comma-separated CIDR list
TRUST_PROXY=false

# canonical base64 of the raw 32-byte Ed25519 public key (verification only; the private key never
# reaches the server). Read only by the rulepack:import CLI.
RULEPACK_PUBLIC_KEY=

# requests per IP per minute (IPv6 clients per /64)
RATE_LIMIT_MAX=120
# delete installs not seen for this many days (their profiles go with them); 0 disables
INSTALL_RETENTION_DAYS=180
DOCS_ENABLED=true
# defaults to the version in package.json
APP_VERSION=
