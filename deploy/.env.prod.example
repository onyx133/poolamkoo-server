# Copy to deploy/.env on the server (chmod 600) and fill in every value.
# deploy/.env is gitignored. Never commit it, and never reuse these secrets elsewhere.
# docker-compose.prod.yml reads this file for interpolation.

# --- Database ---------------------------------------------------------------------------
# Three roles, three different passwords (generate each: openssl rand -hex 24; hex keeps the
# value URL-safe because it is embedded in connection URLs). The roles are created by
# deploy/db-init/01-app-role.sh on FIRST initialisation of the volume; changing a password
# later also needs ALTER ROLE ... PASSWORD '...' (see RUNBOOK).
POSTGRES_DB=poolamkoo

# Bootstrap superuser `poolamkoo_admin`. Only for first-time setup and manual administration
# through the container's unix socket (`dc exec db psql ...`); the stack never uses it over TCP.
POSTGRES_PASSWORD=

# `poolamkoo_owner` (NOT a superuser): owns the database and schema, runs migrations.
OWNER_DB_PASSWORD=

# `poolamkoo_app` (SELECT/INSERT/UPDATE/DELETE only): the API connects as it.
APP_DB_PASSWORD=

# --- API secrets ------------------------------------------------------------------------
# >= 32 bytes, base64 or hex. Generate: openssl rand -base64 48
# Pepper for HMAC-SHA256 install ids. Changing it orphans every install (see RUNBOOK).
SERVER_PEPPER=
# >= 32 bytes. Generate: openssl rand -base64 48
# Signs access tokens (HS256). Changing it logs every install out; apps re-register silently.
JWT_SECRET=

# Canonical base64 of the raw 32-byte Ed25519 PUBLIC key. Printed by `npm run rulepack:keygen` on the release
# machine. Verification only; the private key never goes on this server.
RULEPACK_PUBLIC_KEY=

# --- Optional (defaults shown) ----------------------------------------------------------
LOG_LEVEL=info
JWT_TTL_DAYS=30
# Requests per IP per minute (IPv6 clients count per /64).
RATE_LIMIT_MAX=120
# Maximum pooled database connections.
DB_POOL_MAX=10
# Delete installs not seen for this many days (their profiles go with them); 0 disables.
INSTALL_RETENTION_DAYS=180
# Serve Swagger UI at /docs.
DOCS_ENABLED=true

# Fixed by docker-compose.prod.yml (not read from this file): NODE_ENV=production,
# HOST=127.0.0.1, PORT=3100, TRUST_PROXY=1 (one hop: the host nginx).
