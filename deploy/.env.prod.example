# Copy to deploy/.env on the server (chmod 600) and fill in every value.
# deploy/.env is gitignored. Never commit it, and never reuse these secrets elsewhere.
# docker-compose.prod.yml reads this file for interpolation.

# --- Database ---------------------------------------------------------------------------
# Owner role: runs migrations only. Used by the `db` and `migrate` services.
POSTGRES_OWNER_USER=poolamkoo_owner
POSTGRES_DB=poolamkoo
# Generate: openssl rand -hex 24   (hex keeps the value URL-safe; it is embedded in a URL)
POSTGRES_OWNER_PASSWORD=

# Application role `poolamkoo_app` (SELECT/INSERT/UPDATE/DELETE only). The API connects as it.
# Created by deploy/db-init/01-app-role.sh on FIRST initialisation of the volume. Changing
# it later requires ALTER ROLE poolamkoo_app PASSWORD '...' as well (see RUNBOOK).
# Generate: openssl rand -hex 24
APP_DB_PASSWORD=

# --- API secrets ------------------------------------------------------------------------
# >= 32 bytes, base64 or hex. Generate: openssl rand -base64 48
# Pepper for HMAC-SHA256 install ids. Changing it orphans every install (see RUNBOOK).
SERVER_PEPPER=
# >= 32 bytes. Generate: openssl rand -base64 48
# Signs access tokens (HS256). Changing it logs every install out; apps re-register silently.
JWT_SECRET=

# base64 raw 32-byte Ed25519 PUBLIC key. Printed by `npm run rulepack:keygen` on the release
# machine. Verification only; the private key never goes on this server.
RULEPACK_PUBLIC_KEY=

# --- Optional (defaults shown) ----------------------------------------------------------
LOG_LEVEL=info
JWT_TTL_DAYS=30
# Requests per IP per minute.
RATE_LIMIT_MAX=120
# Serve Swagger UI at /docs.
DOCS_ENABLED=true

# Fixed by docker-compose.prod.yml (not read from this file): NODE_ENV=production,
# HOST=127.0.0.1, PORT=3100, TRUST_PROXY=1 (one hop: the host nginx).
